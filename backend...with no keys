const http = require('http');

const SUPABASE_URL = 'url to connect to database';
const SUPABASE_KEY = 'key here';
const APP_NAME = 'R4K1N';

const sessions = new Map();

function setCors(res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');
}

async function sbQuery(endpoint, options = {}) {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/${endpoint}`, {
      ...options,
      headers: {
        'apikey': SUPABASE_KEY,
        'Authorization': `Bearer ${SUPABASE_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=representation',
        ...(options.headers || {})
      }
    });
    try {
      return await res.json();
    } catch {
      return null;
    }
  } catch (err) {
    console.error('Supabase query error:', err);
    return null;
  }
}

async function findUser(id) {
  const q = (id || '').trim().toLowerCase();
  if (!q) return null;
  const field = q.includes('@') ? 'email' : 'username';
  const data = await sbQuery(`users?${field}=eq.${encodeURIComponent(q)}`);
  return data && data.length > 0 ? data[0] : null;
}

const server = http.createServer((req, res) => {
  setCors(res);

  if (req.method === 'OPTIONS') {
    res.writeHead(204);
    return res.end();
  }

  // Health check for uptime monitors (prevents cold-start idle sleep)
  if (req.method === 'GET' && (req.url === '/' || req.url === '/health')) {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify({ status: 'active', server: 'render' }));
  }

  // Leaderboard fetch
  if (req.method === 'GET' && (req.url === '/api/users' || req.url.startsWith('/api/users'))) {
    (async () => {
      const data = await sbQuery('users?is_banned=eq.false&select=username,score,flag');
      const list = (data || []).map(u => ({
        name: u.username,
        score: u.score || '0',
        flag: u.flag || '🏳️'
      })).sort((a, b) => {
        const diff = BigInt(b.score || 0) - BigInt(a.score || 0);
        return diff > 0n ? 1 : diff < 0n ? -1 : 0;
      });
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify(list));
    })();
    return;
  }

  if (req.method === 'POST') {
    let body = '';
    req.on('data', chunk => {
      body += chunk;
    });

    req.on('end', async () => {
      let data = {};
      try {
        data = JSON.parse(body || '{}');
      } catch {
        res.writeHead(400, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ error: 'Malformed JSON body!' }));
      }

      const action = data.action || '';
      const url = req.url;

      // REGISTER
      if (url === '/api/register' || action === 'register') {
        const username = (data.username || '').trim().toLowerCase();
        const email = (data.email || '').trim().toLowerCase();
        const password = data.password || '';
        const flag = data.flag || '🏳️';

        if (!username || !email || !password) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Username, email, and password required!' }));
        }

        const uExist = await sbQuery(`users?username=eq.${encodeURIComponent(username)}`);
        if (uExist && uExist.length > 0) {
          if (uExist[0].verified) {
            res.writeHead(400, { 'Content-Type': 'application/json' });
            return res.end(JSON.stringify({ error: 'Username taken!' }));
          } else {
            await sbQuery(`users?username=eq.${encodeURIComponent(username)}`, { method: 'DELETE' });
          }
        }

        const eExist = await sbQuery(`users?email=eq.${encodeURIComponent(email)}`);
        if (eExist && eExist.length > 0) {
          if (eExist[0].verified) {
            res.writeHead(400, { 'Content-Type': 'application/json' });
            return res.end(JSON.stringify({ error: 'Email already registered!' }));
          } else {
            await sbQuery(`users?email=eq.${encodeURIComponent(email)}`, { method: 'DELETE' });
          }
        }

// 1. Purge old auth record from auth.users so re-testing always sends a fresh code
        try {
          const adminUsersRes = await fetch(`${SUPABASE_URL}/auth/v1/admin/users`, {
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`
            }
          });
          const adminData = await adminUsersRes.json();
          const existingAuth = (adminData.users || []).find(u => u.email === email);
          if (existingAuth) {
            await fetch(`${SUPABASE_URL}/auth/v1/admin/users/${existingAuth.id}`, {
              method: 'DELETE',
              headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`
              }
            });
          }
        } catch (e) {
          console.error('Auth cleanup error:', e);
        }

        // 2. Fresh signup dispatch (guarantees Gmail dispatches a brand-new code)
        const authRes = await fetch(`${SUPABASE_URL}/auth/v1/signup`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email,
            password,
            data: { username, flag }
          })
        });

        const authData = await authRes.json();
        if (!authRes.ok) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ 
            error: authData.msg || authData.message || authData.error_description || 'Failed to send verification email.' 
          }));
        }

        // Create table record
        await sbQuery('users', {
          method: 'POST',
          body: JSON.stringify({
            username,
            email,
            password,
            flag,
            score: '0',
            verified: false,
            is_banned: false,
            codes: []
          })
        });

        res.writeHead(200, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ success: true, username, email }));
      }

      // VERIFY (Checks 6-digit OTP code)
      if (url === '/api/verify' || action === 'verify') {
        const user = await findUser(data.identifier);
        if (!user) {
          res.writeHead(404, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'User not found!' }));
        }

        const token = (data.code || '').trim();

        // Check signup OTP token
        let verifyRes = await fetch(`${SUPABASE_URL}/auth/v1/verify`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            type: 'signup',
            email: user.email,
            token
          })
        });

        // Fallback check for email OTP type
        if (!verifyRes.ok) {
          verifyRes = await fetch(`${SUPABASE_URL}/auth/v1/verify`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              type: 'email',
              email: user.email,
              token
            })
          });
        }

        if (verifyRes.ok) {
          await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, {
            method: 'PATCH',
            body: JSON.stringify({ verified: true, codes: [] })
          });
          res.writeHead(200, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ 
            success: true, 
            username: user.username, 
            score: (user.score || '0').toString(), 
            flag: user.flag 
          }));
        }

const errData = await verifyRes.json();
        res.writeHead(400, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ error: errData.msg || errData.message || 'Invalid or expired code!' }));
      }

      // RESEND (Dispatches a fresh code via Supabase)
      if (url === '/api/resend' || action === 'resend') {
        const user = await findUser(data.identifier);
        if (!user) {
          res.writeHead(404, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'User not found!' }));
        }

        const resendRes = await fetch(`${SUPABASE_URL}/auth/v1/resend`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ type: 'signup', email: user.email })
        });

        if (resendRes.ok) {
          res.writeHead(200, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ success: true }));
        }

        const errData = await resendRes.json().catch(() => ({}));
        res.writeHead(400, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ error: errData.msg || errData.message || 'Failed to resend code' }));
      }

      // LOGIN
      
      if (url === '/api/login' || action === 'login') {
        const user = await findUser(data.identifier);
        if (!user) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Account not found!' }));
        }
        if (user.is_banned) {
          res.writeHead(403, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Account banned for auto-clicking!' }));
        }
        if (!user.verified) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Please verify your email first!' }));
        }
        if (user.password !== data.password) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Incorrect password!' }));
        }

        res.writeHead(200, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ username: user.username, score: (user.score || '0').toString(), flag: user.flag }));
      }

      // CLICK ENGINE
      if (url === '/api/click' || action === 'click') {
        const user = await findUser(data.username);
        if (!user) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Invalid user' }));
        }
        if (user.is_banned) {
          res.writeHead(403, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'BANNED' }));
        }

        const now = Date.now();
        const count = BigInt(data.count || 1);

        if (count > 25n || count <= 0n) {
          await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, { method: 'PATCH', body: JSON.stringify({ is_banned: true }) });
          res.writeHead(403, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'BANNED' }));
        }

        let sess = sessions.get(user.username);
        if (!sess) {
          sess = { lastTime: now, sessionStart: now, strikeCount: 0 };
          sessions.set(user.username, sess);
        }

        const elapsedMs = Math.max(now - sess.lastTime, 50);

        if (now - sess.lastTime > 40000) {
          sess.sessionStart = now;
        }
        sess.lastTime = now;

        if (now - sess.sessionStart > 25 * 60 * 1000) {
          res.writeHead(429, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Fatigue limit: take a 30s break!' }));
        }

        const cps = Number(count) / (elapsedMs / 1000);
        if (cps > 22) {
          sess.strikeCount++;
          if (sess.strikeCount >= 3) {
            await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, { method: 'PATCH', body: JSON.stringify({ is_banned: true }) });
            res.writeHead(403, { 'Content-Type': 'application/json' });
            return res.end(JSON.stringify({ error: 'BANNED' }));
          }
        } else {
          sess.strikeCount = Math.max(0, sess.strikeCount - 1);
        }

        const nextScore = (BigInt(user.score || '0') + count).toString();
        await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, { method: 'PATCH', body: JSON.stringify({ score: nextScore }) });
        res.writeHead(200, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ score: nextScore }));
      }

      // BAN
      if (url === '/api/ban' || action === 'ban') {
        const user = await findUser(data.username);
        if (user) {
          await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, { method: 'PATCH', body: JSON.stringify({ is_banned: true }) });
        }
        res.writeHead(200, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ banned: true }));
      }

      // RESET
      if (url === '/api/reset' || action === 'reset') {
        const user = await findUser(data.username);
        if (user) {
          await sbQuery(`users?username=eq.${encodeURIComponent(user.username)}`, { method: 'PATCH', body: JSON.stringify({ score: '0' }) });
          res.writeHead(200, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ score: '0' }));
        }
        res.writeHead(404, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ error: 'User not found' }));
      }

      res.writeHead(404, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: 'Route not found' }));
    });
  }
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, '0.0.0.0', () => {
  console.log(`⚡ Render Backend active on ${PORT}`);
});
